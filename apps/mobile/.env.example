# URL de l'API NestJS (Track'N Share).
# Émulateur Android : http://10.0.2.2:3000/api — Simulateur iOS : http://localhost:3000/api
# Device physique : remplacer localhost par l'IP LAN de la machine (ipconfig),
# puis relancer `npm start -- --clear`.
EXPO_PUBLIC_API_URL=http://localhost:3000/api
EXPO_PUBLIC_SOCKET_URL=http://localhost:3000
