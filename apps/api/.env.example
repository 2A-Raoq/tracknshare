NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=tracknshare
DB_PASSWORD=tracknshare
DB_NAME=tracknshare
# Laisser vide pour le comportement par défaut (synchronize hors production).
# Mettre à false pour piloter le schéma via les migrations (pnpm migration:run).
DB_SYNCHRONIZE=

# JWT
JWT_SECRET=dev-jwt-secret-change-me
JWT_EXPIRES_IN=1d
# Clé AES-256-GCM (base64, 32 octets). DOIT être identique à celle du
# docker-compose.yml, sinon le seed (qui lit ce .env) chiffre les messages
# avec une clé que l'API conteneur ne peut pas déchiffrer (« Message indisponible »).
MESSAGE_ENCRYPTION_KEY=enJdZ2SpRGYSNitgujTU3tTHSSVqN6NCpnI8owYZb9s=
STEAM_API_KEY=

# CORS
CORS_ORIGIN=http://localhost:5173
