NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=tracknshare
DB_PASSWORD=tracknshare
DB_NAME=tracknshare
# Laisser vide pour le comportement par défaut (synchronize hors production).
# Mettre à false pour piloter le schéma via les migrations (pnpm migration:run).
DB_SYNCHRONIZE=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=1d
# Base64-encoded 32-byte key for AES-256-GCM message encryption
MESSAGE_ENCRYPTION_KEY=
STEAM_API_KEY=

# CORS
CORS_ORIGIN=http://localhost:5173
