---
title: "Architecture Track'N Share — monorepo 3 apps + types partagés (C1.3)"
---
flowchart TB
  subgraph CLIENTS["Clients (2 front-ends, même API)"]
    subgraph WEB["apps/web — React 18 + Vite (PWA)"]
      PAGES["Pages + composants"]
      SERVICES["Services API centralisés<br/>(axios + validation runtime)"]
      SW["Service worker<br/>(cache leaderboard public uniquement,<br/>purge au logout)"]
      PAGES --> SERVICES
    end
    subgraph MOB["apps/mobile — Expo / React Native"]
      SCREENS["Écrans expo-router<br/>+ notifications in-app"]
      MSRV["Services API<br/>(token en secure-store)"]
      SCREENS --> MSRV
    end
  end

  TYPES["packages/shared-types<br/>contrat API typé unique<br/>(100% types, zéro runtime)"]
  TYPES -.import type.-> SERVICES
  TYPES -.import type.-> MSRV

  subgraph API["apps/api — NestJS 11 (16 modules)"]
    GUARDS["Guards JWT + permissions<br/>(équipe, conversation)"]
    CTRL["Controllers fins + DTO validés"]
    SVC["Services métier<br/>(score calculé côté API)"]
    GW["Gateways Socket.io<br/>(chat, messages, rate-limit)"]
    PROV["Providers de stats<br/>interface commune Mock / Steam"]
    FILTER["Filtre d'exceptions global<br/>(code + requestId)"]
    GUARDS --> CTRL --> SVC
    GW --> SVC
    SVC --> PROV
  end

  subgraph DATA["Données"]
    PG[("PostgreSQL 16<br/>TypeORM + migrations<br/>chiffrement AES-256-GCM des messages")]
    REDIS[("Redis 7<br/>cache leaderboard (TTL + invalidation)<br/>+ rate limiting")]
  end

  STEAM["API Steam<br/>(clé côté serveur uniquement)"]

  SERVICES -- "REST /api" --> GUARDS
  MSRV -- "REST /api" --> GUARDS
  SERVICES <-. "Socket.io (JWT)" .-> GW
  MSRV <-. "Socket.io (JWT)" .-> GW
  SVC --> PG
  SVC --> REDIS
  PROV --> STEAM

  CI["CI GitHub Actions (bloquante)<br/>lint 0 warning + build + 46 tests<br/>+ 8 e2e sur Postgres/Redis réels<br/>+ typecheck & lint mobile"]
  CI -.protège.-> API
  CI -.protège.-> CLIENTS
