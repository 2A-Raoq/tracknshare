---
title: "Circulation des rapports de maintenance — Roofline (C2.3 / C2.5)"
---
flowchart LR
  subgraph SITES["Sites clients WordPress (x17)"]
    WSAL["Logs WP Activity Log<br/>(mises à jour core/plugins/thèmes)"]
    PLUGIN["Plugin Rapport Maintenance<br/>(checklist par forfait + collecte auto)"]
    CSV["Rapport CSV normalisé<br/>UTF-8 BOM + sections"]
    WSAL --> PLUGIN
    PLUGIN --> CSV
  end

  subgraph TRANSPORT["Contrat d'échange"]
    REST["Pull REST synchrone<br/>/rapport-maintenance/v1/…<br/>token + CSV base64 + SHA-256"]
    HOOK["Push webhook asynchrone<br/>X-Rapport-Maintenance-Token"]
  end

  subgraph DASH["Dashboard Laravel (prod OVH)"]
    IMPORT["Import + vérification d'intégrité<br/>hash_equals(SHA-256)"]
    DB[("Base clients<br/>(rapports, config, journaux)")]
    GSC["Enrichissement Google Search Console<br/>OAuth2 + refresh token<br/>(cron lundi 3h, anti-quota)"]
    MAILS["Envois programmés SMTP OVH<br/>jour paramétré par client<br/>+ journal + pixel d'ouverture"]
    MON["Monitoring cron + alerting"]
    IMPORT --> DB
    GSC --> DB
    DB --> MAILS
    MON -.surveille.-> GSC
    MON -.surveille.-> MAILS
  end

  CLIENT["Client final<br/>(rapport mensuel par e-mail)"]
  GERANTE["Gérante Roofline<br/>(suivi + retours clients)"]

  CSV --> REST --> IMPORT
  PLUGIN --> HOOK --> IMPORT
  MAILS --> CLIENT
  DB --> GERANTE
